# Copiar este archivo como .env.local y completar con los valores reales.
# .env.local nunca se sube al repo (está en .gitignore).

# Supabase: botón «Connect» del proyecto (o Settings → API Keys). Las dos son
# públicas por diseño; lo que protege los datos son las reglas de Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Cloudinary (fotos de los autos): console.cloudinary.com → Settings → API Keys.
# El nombre de la cuenta va en cada link de foto (no es secreto). La clave de la API y la
# secreta sólo las usa el servidor; la secreta nunca va con NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cuenta
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
