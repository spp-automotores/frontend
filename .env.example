# Copiar este archivo como .env.local y completar con los valores reales.
# .env.local nunca se sube al repo (está en .gitignore).

# Supabase: Project Settings → API. Las dos son públicas por diseño (las ve
# el navegador); lo que protege los datos son las reglas de Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
