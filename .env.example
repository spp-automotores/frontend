# Copiar este archivo como .env.local y completar con los valores reales.
# .env.local nunca se sube al repo (está en .gitignore).

# Supabase: botón «Connect» del proyecto (o Settings → API Keys). Las dos son
# públicas por diseño; lo que protege los datos son las reglas de Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clave de la tarea diaria que mantiene despierta la base (app/api/mantener-base).
# Vercel la manda sola al llamar la tarea. Es secreta: sin NEXT_PUBLIC_.
# Una larga y al azar, por ejemplo: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=
